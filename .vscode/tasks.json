{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "本地预览（含 R2 数据）",
      "type": "shell",
      "command": "npm.cmd run dev",
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "problemMatcher": {
        "owner": "local-preview",
        "pattern": { "regexp": "^(.+):(\\d+): (.+)$", "file": 1, "line": 2, "message": 3 },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".+",
          "endsPattern": "LOCAL_PREVIEW_READY"
        }
      },
      "presentation": { "reveal": "always", "panel": "dedicated" },
      "runOptions": { "instanceLimit": 1 }
    },
    {
      "label": "本地检查",
      "type": "shell",
      "command": "npm.cmd test",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    }
  ]
}
