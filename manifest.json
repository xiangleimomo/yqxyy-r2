{
  "manifest_version": 3,
  "name": "影仓 TMDB OneClick Player",
  "version": "3.0.0",
  "description": "TMDB 原网页增强：默认精简模式，可切换原版/海报模式，点击影视海报直接打开 HLS 播放器。",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://api.obj2.top/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.themoviedb.org/*",
        "https://themoviedb.org/*"
      ],
      "js": [
        "content.js",
        "display-mode.js"
      ],
      "css": [
        "content.css",
        "display-mode.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "player.html",
        "player.js",
        "player.css",
        "vendor/hls.min.js"
      ],
      "matches": [
        "https://www.themoviedb.org/*",
        "https://themoviedb.org/*"
      ]
    }
  ],
  "options_page": "options.html"
}
